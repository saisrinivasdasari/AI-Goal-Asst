datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector"), uuidOssp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum PriorityLevel {
  P0_CRITICAL
  P1_IMPORTANT
  P2_OPTIONAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
  RESCHEDULED
  PRUNED
}

enum MemoryType {
  GOAL
  LEARNING
  EXPERIENCE
  IDEA
  DECISION
  HABIT
  ACHIEVEMENT
  FAILURE
  PREFERENCE
  REFLECTION
}

enum EnergyLevel {
  HIGH_FOCUS
  MEDIUM
  LOW_RECOVERY
}

enum MemoryDurability {
  TEMPORARY        // Auto-expires after 7 days
  SHORT_TERM       // Kept for monthly review
  LONG_TERM        // Core memory
  PERMANENT        // Identity-defining / explicit remember
}

enum UserIntent {
  GOAL_CREATE
  JOURNAL_ENTRY
  MEMORY_QUERY
  IDEA_CAPTURE
  SCHEDULE_QUERY
  RESCHEDULING
  GENERAL_CHAT
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  profile           UserProfile?
  lifeAreas         LifeArea[]
  antiGoals         AntiGoal[]
  capacitySchedule  CapacitySchedule?
  energyProfile     EnergyProfile?
  goals             Goal[]
  memories          UniversalMemory[]
  journalEntries    JournalEntry[]
  weeklyReviews     WeeklyReview[]
  monthlyReviews    MonthlyReview[]
  chatSessions      ChatSession[]

  @@map("users")
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  fullName            String
  timezone            String   @default("UTC")
  motivationalStyle   String   @default("supportive_friend") // supportive_friend, future_self, stoic, ambitious
  preferredWorkDays   Int[]    @default([1, 2, 3, 4, 5])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model CapacitySchedule {
  id                  String   @id @default(cuid())
  userId              String   @unique
  dayJobHoursWeekly   Float    @default(40.0)
  sleepHoursDaily     Float    @default(7.5)
  commuteHoursDaily   Float    @default(1.0)
  fixedCommitmentsWeekly Float @default(10.0)
  netAvailableGoalHours Float  // 168 - (sleep*7 + work + commute*5 + fixed)
  peakEnergyWindow    EnergyLevel @default(HIGH_FOCUS)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("capacity_schedules")
}

model EnergyProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  morningEnergy   EnergyLevel @default(HIGH_FOCUS)   // 6am - 12pm
  afternoonEnergy EnergyLevel @default(MEDIUM)       // 12pm - 6pm
  eveningEnergy   EnergyLevel @default(MEDIUM)       // 6pm - 9pm
  nightEnergy     EnergyLevel @default(LOW_RECOVERY) // 9pm - 12am
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("energy_profiles")
}

model LifeArea {
  id          String   @id @default(cuid())
  userId      String
  name        String   // Career, Fitness, Health, Relationships, Learning, Finance
  icon        String?
  color       String?
  targetShare Float    @default(0.2) // Target % of weekly effort
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals       Goal[]
  memories    UniversalMemory[]

  @@unique([userId, name])
  @@map("life_areas")
}

model AntiGoal {
  id          String   @id @default(cuid())
  userId      String
  description String   // "Don't burn out", "Don't work past 10 PM"
  consequence String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("anti_goals")
}

model Goal {
  id                 String          @id @default(cuid())
  userId             String
  lifeAreaId         String
  title              String
  dreamVision        String          // Top-level dream anchor
  whyReason          String          // Emotional core: "Why do I want this?"
  whyNow             String          // "Why is this urgent now?"
  costOfInaction     String          // "What happens if I stay where I am?"
  successDefinition  String          // Measurable finish line
  targetDate         DateTime
  estimatedHoursTotal Float
  completedAt        DateTime?
  status             String          @default("ACTIVE") // ACTIVE, PAUSED, ACHIEVED, EVOLVED
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeArea           LifeArea        @relation(fields: [lifeAreaId], references: [id])
  milestones         GoalMilestone[]
  memories           UniversalMemory[]

  @@index([userId, status])
  @@map("goals")
}

model GoalMilestone {
  id             String         @id @default(cuid())
  goalId         String
  title          String
  orderIndex     Int
  targetDate     DateTime
  progressPct    Float          @default(0.0)
  completedAt    DateTime?
  goal           Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  weeklyTargets  WeeklyTarget[]

  @@index([goalId, orderIndex])
  @@map("goal_milestones")
}

model WeeklyTarget {
  id             String         @id @default(cuid())
  milestoneId    String
  title          String
  weekNumber     Int            // 1-52
  year           Int
  targetHours    Float
  completedAt    DateTime?
  milestone      GoalMilestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([milestoneId, year, weekNumber])
  @@map("weekly_targets")
}

model Task {
  id             String         @id @default(cuid())
  weeklyTargetId String
  title          String
  description    String?
  priority       PriorityLevel  @default(P1_IMPORTANT)
  estimatedMinutes Int          @default(60)
  requiredEnergy EnergyLevel    @default(MEDIUM)
  weeklyTarget   WeeklyTarget   @relation(fields: [weeklyTargetId], references: [id], onDelete: Cascade)
  instances      TaskInstance[]

  @@map("tasks")
}

model TaskInstance {
  id             String         @id @default(cuid())
  taskId         String
  scheduledDate  DateTime       @db.Date
  status         TaskStatus     @default(PENDING)
  actualMinutes  Int?
  notes          String?
  rescheduledCount Int          @default(0)
  completedAt    DateTime?
  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([scheduledDate, status])
  @@index([taskId])
  @@map("task_instances")
}

model UniversalMemory {
  id             String                     @id @default(cuid())
  userId         String
  goalId         String?
  lifeAreaId     String?
  type           MemoryType
  durability     MemoryDurability           @default(LONG_TERM)
  topic          String                     // E.g., "Badminton", "Redis", "Sleep"
  content        String
  sourceContext  String?                    // "Conversational Journal", "Explicit Remember"
  importance     Int                        @default(3) // 1 to 5 scale
  isPrivate      Boolean                    @default(false)
  expiresAt      DateTime?                  // Auto-expiry timestamp (for TEMPORARY tier)
  embedding      Unsupported("vector(768)")? // Nomic-embed-text 768 dimensions
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           Goal?                      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  lifeArea       LifeArea?                  @relation(fields: [lifeAreaId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([userId, topic])
  @@index([userId, durability])
  @@index([expiresAt])
  @@map("universal_memories")
}

model JournalEntry {
  id             String         @id @default(cuid())
  userId         String
  rawInputText   String
  entryDate      DateTime       @db.Date
  detectedMood   String?
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          JournalItem[]

  @@index([userId, entryDate])
  @@map("journal_entries")
}

model JournalItem {
  id             String         @id @default(cuid())
  journalEntryId String
  category       String         // Work, Fitness, Learning, Health, Reflection
  content        String
  isCompleted    Boolean        @default(true)
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@map("journal_items")
}

model WeeklyReview {
  id                 String     @id @default(cuid())
  userId             String
  weekStartDate      DateTime   @db.Date
  totalPlannedHours  Float
  totalActualHours   Float
  completedTasksCount Int
  missedTasksCount   Int
  blockerObservations String?
  aiSuggestion       String?
  userAdjustmentNotes String?
  createdAt          DateTime   @default(now())
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStartDate])
  @@map("weekly_reviews")
}

model MonthlyReview {
  id                   String   @id @default(cuid())
  userId               String
  monthStartDate       DateTime @db.Date
  achievementsSummary  String?
  learningSummary      String?
  challengesSummary    String?
  patternsSummary      String?
  identityShiftNotes   String?  // "What changed about you this month?"
  lifeAreaDistribution Json?    // { career: 0.45, fitness: 0.2, ... }
  aiRecommendations    String?
  userReflections      String?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, monthStartDate])
  @@map("monthly_reviews")
}

model ChatSession {
  id             String         @id @default(cuid())
  userId         String
  title          String         @default("Conversation with Jarvis")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id             String         @id @default(cuid())
  sessionId      String
  role           String         // user, assistant, system
  content        String
  tokensUsed     Int?
  createdAt      DateTime       @default(now())
  session        ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

