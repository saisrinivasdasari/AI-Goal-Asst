# Database Connections (Supabase PostgreSQL + pgvector)
# For production/Vercel: Use the Connection Pooler (Session mode: port 5432 or Transaction mode: port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth & Client
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# AI Provider Configuration ('gemini' for ultra-fast cloud, or 'ollama' for local machine)
AI_PROVIDER="gemini"
GEMINI_API_KEY="[YOUR_GEMINI_API_KEY]"
GEMINI_CHAT_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Local AI Runtime Fallback (Ollama on localhost)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_CHAT_MODEL="qwen3:4b"
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_NUM_CTX="4096"

# Environment
NODE_ENV="production"
